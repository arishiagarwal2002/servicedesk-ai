# Copy to .env and fill in. Never commit .env.
APP_ENV=development

# mock | azure_openai   — start with mock so UI/API work is not blocked on access
MODEL_PROVIDER=mock

DATABASE_URL=postgresql://servicedesk:servicedesk@localhost:5432/servicedesk

# Only needed when MODEL_PROVIDER=azure_openai. Use managed identity where
# available rather than a key.
AZURE_OPENAI_ENDPOINT=
GENERATION_DEPLOYMENT=
EMBEDDING_DEPLOYMENT=

# Version stamps written onto every analysis so a result can be reproduced.
CORPUS_VERSION=synthetic-v1
PROMPT_VERSION=draft-v1
CLASSIFIER_VERSION=baseline-v1
